// Google OAuth credentials for NotchSnap.
//
// Copy this file to  Config/GoogleOAuth.xcconfig  and paste your values in.
// That copy is gitignored, because this repository is public.
//
// You only do this ONCE, as the app's developer. Everyone who runs the built
// app just clicks "Sign in with Google" — they never see a client ID.
//
// To get the values:
//   1. https://console.cloud.google.com/apis/credentials  (create a project)
//   2. APIs & Services > Library > enable "Google Calendar API"
//   3. Credentials > Create credentials > OAuth client ID > Desktop app
//   4. Copy the Client ID and Client secret below
//
// Note: for an installed app Google does not treat the "secret" as
// confidential — it necessarily ships inside every copy of the app. PKCE is
// what actually protects the token exchange. Keeping it out of the public repo
// is still worth doing, which is why this file is a template.

GOOGLE_OAUTH_CLIENT_ID = 
GOOGLE_OAUTH_CLIENT_SECRET = 
