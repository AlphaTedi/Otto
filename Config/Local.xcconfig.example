// Local build settings for NotchSnap — copy to  Config/Local.xcconfig
//
// That copy is gitignored: this repository is public, so nothing here should
// be committed. Everything is optional — with an empty file the app still
// builds and runs ad-hoc signed, exactly as it does today.

// ---------------------------------------------------------------- SIGNING --
// Needed to distribute the app the way a normal Mac app is distributed:
// download, double-click, it opens. Requires the Apple Developer Program
// ($99/yr) — that is the only thing the fee buys you here.
//
// Find the exact string with:   security find-identity -v -p codesigning
// It looks like: Developer ID Application: Your Name (ABCDE12345)
// Use just the "Developer ID Application" part; Xcode matches the rest.
//
// Leave BLANK to keep building ad-hoc (works locally, needs xattr/tccutil on
// other Macs, and resets permissions on every rebuild).

// CODE_SIGN_IDENTITY = Developer ID Application
// DEVELOPMENT_TEAM = ABCDE12345

// Notarization needs a stored credential. Create it once with:
//   xcrun notarytool store-credentials "NotchSnap" \
//     --apple-id you@example.com --team-id ABCDE12345 --password <app-specific-password>
// (app-specific password comes from appleid.apple.com > Sign-In and Security)
// NOTARY_PROFILE = NotchSnap

// -------------------------------------------------------------- TELEMETRY --
// Anonymous, opt-in usage counts (docs/TELEMETRY.md). The host of the
// Cloudflare Worker in server/, WITHOUT https:// — a `//` starts a comment in
// an xcconfig. The key is the Worker's OTTO_KEY (wrangler.toml); it is not a
// secret, it only keeps random traffic out. Leave blank: nothing is ever sent.
OTTO_SERVICE_HOST =
OTTO_SERVICE_KEY =

// -------------------------------------------------------------- HARDENING --
// Hardened Runtime is REQUIRED for notarization. Release-only so day-to-day
// debug builds are unaffected.
ENABLE_HARDENED_RUNTIME[config=Release] = YES
OTHER_CODE_SIGN_FLAGS[config=Release] = --timestamp
// get-task-allow lets a debugger attach. Xcode injects it automatically and
// notarization rejects any binary carrying it, so it must be off for Release.
CODE_SIGN_INJECT_BASE_ENTITLEMENTS[config=Release] = NO
// Manual, because Developer ID distribution is not what automatic signing
// picks on its own.
CODE_SIGN_STYLE = Manual

// ------------------------------------------------------------------ VERSION --
// release.sh overrides these from the git tag. These are only the fallback for
// a plain `xcodebuild` run.
MARKETING_VERSION = 0.0.0
CURRENT_PROJECT_VERSION = 1
